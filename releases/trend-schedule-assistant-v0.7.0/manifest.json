{
  "manifest_version": 3,
  "name": "趋势任务助手",
  "version": "0.7.0",
  "description": "识别 X 趋势任务中的日期、时间、关键词和话题标签，并换算为北京时间。",
  "permissions": ["activeTab", "storage", "tabs", "sidePanel", "alarms", "notifications"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "action": {
    "default_title": "打开趋势任务助手侧边栏"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
